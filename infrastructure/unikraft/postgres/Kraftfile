spec: v0.7

name: demo-fga-postgres

runtime: base-compat:latest

targets:
  - kraftcloud/x86_64

rootfs:
  source: ./Dockerfile
  format: erofs

# max_wal_size: the default (1GB) is larger than the 512MiB data volume that
# scripts/deploy.sh attaches, so WAL could fill it before a checkpoint.
cmd: ["/usr/local/bin/wrapper.sh", "postgres", "-c", "shared_preload_libraries=pg_ukc_scaletozero", "-c", "max_wal_size=128MB"]

# Vendored from github.com/unikraft-cloud/examples/tree/main/postgres and
# patched to run as root. Unlike upstream, the Dockerfile sets the PostgreSQL
# version once (ARG PG_VERSION) and collects the runtime libraries with ldd
# instead of listing them. scripts/deploy.sh passes the runtime settings: no
# public port, the data volume, scale-to-zero and the credentials.
