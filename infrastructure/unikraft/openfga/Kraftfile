spec: v0.7

name: demo-fga-openfga

runtime: base-compat:latest

targets:
  - kraftcloud/x86_64

rootfs:
  source: ./Dockerfile
  format: erofs

# entrypoint.sh writes the TLS certificates deploy.sh passes to files, then
# runs `openfga run`.
cmd: ["/usr/local/bin/entrypoint.sh", "run"]

# Safe defaults baked into the image, so even a manual `unikraft run` without
# scripts/deploy.sh can't start an open server: no datastore URI means an
# error rather than an in-memory store, and no preshared keys means a refusal
# to start. Non-secrets only (the image config is readable by anyone with
# registry access; scripts/check-kraftfiles.sh enforces it). Env passed at run
# time overrides these by name.
env:
  OPENFGA_DATASTORE_ENGINE: postgres
  OPENFGA_AUTHN_METHOD: preshared
  OPENFGA_PLAYGROUND_ENABLED: "false"
  OPENFGA_HTTP_ADDR: 0.0.0.0:8080
  OPENFGA_LOG_FORMAT: json
  OPENFGA_LOG_LEVEL: info

# Secrets, tunables, memory, scale-to-zero and the private network are set by
# scripts/deploy.sh.
