spec: v0.7

name: openfga-server

runtime: base-compat:latest

targets:
  - kraftcloud/x86_64

# Paths are relative to this Kraftfile. The Dockerfile lives at the repo root
# and uses the repo root as its build context.
rootfs:
  source: ../../../Dockerfile.openfga
  format: erofs

cmd: ["/usr/bin/openfga", "run"]

# Runtime settings (memory, env, scale-to-zero, no public port) are passed to
# `unikraft run`; see scripts/deploy.sh.
