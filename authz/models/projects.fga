module projects

# Folders nest. Access granted on a folder flows down to its subfolders and to
# the projects inside them.
type folder
  relations
    define org: [org]
    # feature: recursion (tuple-to-userset over the same type)
    define parent: [folder]
    define owner: [user, team#member]
    # Owners of a folder, or of any folder above it, manage the projects inside.
    define manager: owner or manager from parent
    define editor: [user, team#member] or owner or editor from parent
    # feature: conditions on usersets — a team can get temporary read access.
    define viewer: [user, team#member, team#member with non_expired_grant] or editor or viewer from parent
    # Blocked in the org of this folder or of any folder above it; projects
    # inside inherit the block even when they have no org of their own.
    define blocked_in_org: blocked from org or blocked_in_org from parent

type project
  relations
    define org: [org]
    define folder: [folder]
    define owner: [user]
    # feature: conditions mixed with plain grants of the same type — some
    # contributors may only edit from the office network.
    define contributor: [user, team#member, user with from_office_network]
    # feature: public access (user:*), permanently or for a limited time
    define viewer: [user, team#member, user:*, user:* with non_expired_grant]
    define blocked: [user]
    define member: owner or contributor or viewer
    define can_manage: owner or admin from org or manager from folder
    # feature: exclusion (but not) — a block on the project, in its org, or in
    # the org of its folder wins over every grant, here and on its lists and
    # tasks. can_manage isn't excluded, so a blocked manager can still unblock.
    define is_blocked: blocked or blocked from org or blocked_in_org from folder
    define can_edit: (contributor or editor from folder or can_manage) but not is_blocked
    define can_view: (member or viewer from folder or can_manage) but not is_blocked
    # feature: intersection (and) — sharing needs edit rights and org membership.
    define can_share: can_edit and member from org

type list
  relations
    define project: [project]
    define owner: [user]
    define collaborator: [user]
    define viewer: [user]
    # Inherit through the project's permissions (can_*), not its raw roles, and
    # exclude the project's block from direct list grants too: a user blocked
    # on the project, or in its org, loses every list in it.
    define member: owner or collaborator or viewer
    define is_blocked: is_blocked from project
    define can_edit: (owner or collaborator or can_edit from project) but not is_blocked
    define can_view: (member or can_view from project) but not is_blocked
    define can_share: (owner or collaborator or can_share from project) but not is_blocked
