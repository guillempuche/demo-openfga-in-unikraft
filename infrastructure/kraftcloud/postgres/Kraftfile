spec: v0.7

name: demo-fga-postgres

runtime: base-compat:latest

targets:
  - kraftcloud/x86_64

rootfs:
  source: ./Dockerfile
  format: erofs

# max_wal_size: the default (1GB) is larger than the 512MiB data volume that
# scripts/deploy.sh attaches, so WAL could fill it before a checkpoint.
cmd: ["/usr/local/bin/wrapper.sh", "postgres", "-c", "shared_preload_libraries=pg_ukc_scaletozero", "-c", "max_wal_size=128MB"]

# Vendored from github.com/unikraft-cloud/examples/tree/main/postgres
# (PostgreSQL 16.4, patched to run as root). Runtime settings (private, volume,
# credentials) are passed by scripts/deploy.sh.
