{
  "name": "demo-fga-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rolldown -c",
    "start": "node src/main.ts",
    "test": "npm run build && node --test server.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && NODE_EXTRA_CA_CERTS=\"${TLS_CA_FILE:-../.cache/tls/ca.crt}\" node --test integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rolldown": "1.2.12",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@openfga/sdk": "0.9.7",
    "effect": "4.0.0"
  }
}
