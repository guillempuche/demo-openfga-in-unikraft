# Copy to .env (gitignored) and fill in. Never commit real values.

# Neon Postgres, direct (unpooled) connection string for the OpenFGA database.
NEON_OPENFGA_DIRECT_URL=postgresql://USER:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/openfga?sslmode=require

# OpenFGA preshared key, shared by the server and the API (no commas).
# Generate one with: openssl rand -hex 32
FGA_KEY=

# Optional overrides
# UNIKRAFT_ORG=gaaaa
# UNIKRAFT_METRO=fra
