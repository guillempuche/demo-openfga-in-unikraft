# Copy to .env (gitignored) and fill in. Never commit real values.

# Unikraft CLI profile (created by `unikraft login`) the scripts must use.
# Image refs are <UNIKRAFT_ORG>/demo-fga-*; the org defaults to the profile name.
UNIKRAFT_PROFILE=kybrion
# UNIKRAFT_ORG=kybrion
# UNIKRAFT_METRO=fra

# OpenFGA preshared key, shared by the server and the API (no commas).
# Generate one with: openssl rand -hex 32
FGA_KEY=

# Password of the private Postgres instance (hex keeps it URL-safe).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: use an external Postgres instead of the demo-fga-postgres instance.
# OPENFGA_DATASTORE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
