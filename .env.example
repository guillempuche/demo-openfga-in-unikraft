# Copy to .env (gitignored) and fill in. Never commit real values.

# Unikraft CLI profile (created by `unikraft login`) the scripts must use.
# Image refs are <UNIKRAFT_ORG>/demo-fga-*; the org defaults to the profile name.
UNIKRAFT_PROFILE=kybrion
# UNIKRAFT_ORG=kybrion
# UNIKRAFT_METRO=fra

# OpenFGA preshared key, shared by the server and the API (no commas).
# Generate one with: openssl rand -hex 32
FGA_KEY=

# Password of the private Postgres instance (hex keeps it URL-safe).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# TLS (encrypted, authenticated connections) between the API, OpenFGA and
# PostgreSQL: on by default. Create the certificates once with
# ./scripts/tls.sh (into .cache/tls). Set off only where something else
# already encrypts this traffic, such as a service mesh.
# INTERNAL_TLS=on

# Optional: your own certificates (a company CA, Vault, step-ca,
# cert-manager) instead of scripts/tls.sh's, as PEM files. Each server
# certificate must be valid for the instance's private name
# (demo-fga-postgres.internal, demo-fga-openfga.internal) and chain to
# TLS_CA_FILE; a file may include intermediate certificates after the server's.
# deploy.sh checks them before deploying (scripts/check-certificates.mjs).
# TLS_CA_FILE=/path/to/ca.crt
# POSTGRES_TLS_CERT_FILE=/path/to/postgres.crt
# POSTGRES_TLS_KEY_FILE=/path/to/postgres.key
# OPENFGA_TLS_CERT_FILE=/path/to/openfga.crt
# OPENFGA_TLS_KEY_FILE=/path/to/openfga.key

# Optional: use an external PostgreSQL instead of the demo-fga-postgres
# instance. Verify its certificate (verify-full):
# - with a public CA (Neon, Supabase, ...): sslrootcert=system
#   OPENFGA_DATASTORE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full&sslrootcert=system
# - with its own CA (Amazon RDS, Cloud SQL, ...): give the CA file, which
#   OpenFGA receives as /tmp/tls/ca.crt
#   OPENFGA_DATASTORE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full&sslrootcert=/tmp/tls/ca.crt
#   OPENFGA_DATASTORE_CA_FILE=/path/to/provider-ca.pem
