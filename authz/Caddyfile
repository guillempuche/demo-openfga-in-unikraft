{
	# Caddy serves plain HTTP on localhost:8080 (published on the loopback
	# interface only) and doesn't request certificates for itself.
	auto_https off
}

# OpenFGA API endpoint: TLS from here to OpenFGA, checking its certificate
# against the CA from scripts/tls.sh and the name it was issued for.
:8080 {
	reverse_proxy https://demo-fga-openfga.internal:8080 {
		transport http {
			tls_trust_pool file /tls/ca.crt
			tls_server_name demo-fga-openfga.internal
		}
	}
	# CORS headers are injected by the OpenFGA server (see OPENFGA_HTTP_CORS_* env vars)
}

# The Playground is a separate compose profile (see docker-compose.yaml).
