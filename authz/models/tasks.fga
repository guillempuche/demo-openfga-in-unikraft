module tasks

# feature: extend type — the tasks module adds project permissions without
# editing projects.fga.
extend type project
  relations
    define can_create_task: can_edit
    # feature: conditions on usersets (map<string>) + intersection — exporting
    # needs a plan that enables it and read access to the project.
    define exporter: [org#member with plan_allows]
    define can_export: exporter and can_view

type task
  relations
    define list: [list]
    define owner: [user]
    define assignee: [user]
    define follower: [user]

    define can_view: owner or assignee or follower or can_view from list
    define can_edit: owner or assignee or can_edit from list
    define can_complete: owner or assignee
    define can_comment: owner or assignee or follower or can_edit from list
